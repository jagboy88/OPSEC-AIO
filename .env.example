# Public hostname. Caddy obtains a TLS certificate for it automatically.
# Keep `localhost` for local testing (uses Caddy's internal CA).
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443
LOG_LEVEL=warn
# Cap on encrypted Drop storage across all live files (bytes). Default 20 GiB.
# Keep it well below the free space on the blob volume.
DROP_STORAGE_MAX_BYTES=21474836480
